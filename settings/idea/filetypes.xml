<?xml version="1.0" encoding="UTF-8"?>
<!-- settings/idea/filetypes.xml -->
<application>
  <component name="FileTypeManager" version="17">
    <ignoreFiles list="*$py.class;*.pyc;*.pyo;*.rbc;*.yarb;*~;.DS_Store;.git;.hg;.svn;CVS;__pycache__;_svn;vssver.scc;vssver2.scc;" />
    <extensionMap>
      <!-- Associate .qrc with XML (matching VS Code qt associations) -->
      <association ext="qrc" type="XML" />
      <!-- Associate .j2 and .mjml with HTML/XML respectively -->
      <association ext="j2" type="HTML" />
      <association ext="mjml" type="XML" />
    </extensionMap>
  </component>
</application>
